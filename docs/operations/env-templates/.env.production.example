# Production: chaves segregadas de producao somente apos go/no-go humano. Mock proibido.
# NEXT_PUBLIC_USE_MOCK_DATA=false
# Template de variaveis por ambiente.
# Copie os nomes para o gerenciador de secrets do ambiente correspondente.
# Nunca commitar valores reais, tokens, cookies, signed URLs ou dados de paciente.

