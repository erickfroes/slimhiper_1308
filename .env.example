D4SIGN_FOLDER_UUID=
D4SIGN_AUTO_DISCOVER_SAFE=
D4SIGN_WEBHOOK_TOKEN=
D4SIGN_WEBHOOK_HMAC_SECRET=

# Asaas server-side / Edge Function only
ASAAS_API_KEY=
ASAAS_BASE_URL=
ASAAS_WEBHOOK_TOKEN=

# Optional AI/provider keys, server-side only if used
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
