#
# Copy this file to .env.local for local development.
# Keep real values out of Git.
#

# Browser-safe public values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_USE_MOCK_DATA=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase server-side, scripts, and Edge Functions
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=
SUPABASE_BOOTSTRAP_PASSWORD=
SUPABASE_BOOTSTRAP_TENANT_SLUG=
SUPABASE_BOOTSTRAP_TENANT_NAME=

# Contract test inputs
TEST_ACCESS_TOKEN=
TEST_PATIENT_ID=
TEST_TEMPLATE_ID=
TEST_PATIENT_CPF_CNPJ=
RUN_D4SIGN_SANDBOX_SEND=
REQUIRE_ASAAS_PROVIDER_SUCCESS=
ALLOW_ASAAS_PROVIDER_CONTRACT_NON_SANDBOX=

# D4Sign server-side / Edge Function only
D4SIGN_TOKEN_API=
D4SIGN_CRYPT_KEY=
D4SIGN_BASE_URL=
